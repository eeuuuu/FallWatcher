	.io_ddrA_r_payload_id		(io_r_payload_id),
	.io_ddrA_r_payload_resp		(io_r_payload_resp),
	.io_ddrA_r_payload_last		(io_r_payload_last),
	.io_ddrA_w_payload_id		(io_w_payload_id),

	
	//user custom ports
    .o_LED(w_soc_led),					//Bit [3:0]
	.i_switch(w_soc_switch),

	//Reg 2 RGB Gain Control
	.o_red_gain(w_vio_r_gain),				//Bit [2:0]
	.o_green_gain(w_vio_g_gain),			//Bit [6:4]
	.o_blue_gain(w_vio_b_gain),				//Bit [10:8]
  
    //UVC Control
	.o_uvc_resetn(uvc_out_resetn_OE),
  
    .i_uvc_status(uvc_status),
	.o_uvc_control(uvc_control),
	  
	.o_uvc_X_START(w_uvc_X_START),
	.o_uvc_X_WIN(w_uvc_X_WIN),
	.o_uvc_Y_START(w_uvc_Y_START),
	.o_uvc_Y_WIN(w_uvc_Y_WIN),
    
	//SOC Ports
		//Uart
	.system_uart_0_io_txd		(system_uart_0_io_txd),
	.system_uart_0_io_rxd		(system_uart_0_io_rxd),
  
		//SPI 0
	.system_spi_0_io_sclk_write			(system_spi_0_io_sclk_write),
	.system_spi_0_io_data_0_writeEnable	(system_spi_0_io_data_0_writeEnable),
	.system_spi_0_io_data_0_read		(system_spi_0_io_data_0_read),
	.system_spi_0_io_data_0_write		(system_spi_0_io_data_0_write),
	.system_spi_0_io_data_1_writeEnable	(system_spi_0_io_data_1_writeEnable),
	.system_spi_0_io_data_1_read		(system_spi_0_io_data_1_read),
	.system_spi_0_io_data_1_write		(system_spi_0_io_data_1_write),  
	.system_spi_0_io_ss					(system_spi_0_io_ss),  
	  
      //I2C
        
    .system_i2c_0_io_sda_write	    (system_i2c_0_io_sda_write),
    .system_i2c_0_io_sda_read	    (system_i2c_0_io_sda_read),
    .system_i2c_0_io_scl_write	    (system_i2c_0_io_scl_write),
    .system_i2c_0_io_scl_read	    (system_i2c_0_io_scl_read),
   
	  
	//Video Stream Input
       
    .in_vclk    (i_mipi_rx_pclk),
	.in_0_x_wr  (),
	.in_0_y_wr  (),
	.in_0_wr_en (w_mipi_rx_de	[0]),
    .in_0_vs    (w_mipi_rx_vs    [0]),
	.in_0_hs    (w_mipi_rx_hs	[0]),
	.in_0_wr_00 (w_mipi_rx_data	[0][9:2]),
	.in_0_wr_01 (w_mipi_rx_data	[0][19:12]),
	.in_0_wr_10 (w_mipi_rx_data	[0][29:22]),
	.in_0_wr_11 (w_mipi_rx_data	[0][39:32]),
	
    
	//Video Stream Output
    .out_vclk   (i_sysclk),
    .out_0_de		(w_frame_buf_ah		[0]),
	.out_0_valid	(w_frame_buf_de		[0]),
	.out_0_hsync	(w_frame_buf_hs		[0]),
	.out_0_vsync	(w_frame_buf_vs		[0]),
	.out_0_rd_00	(w_frame_buf_data	[0][7:0]),
	.out_0_rd_01	(w_frame_buf_data	[0][15:8]),
	.out_0_rd_10	(w_frame_buf_data	[0][23:16]),
	.out_0_rd_11	(w_frame_buf_data	[0][31:24]),
    
    //SD Card Host Access
    .sd_base_clk(i_mipi_clk),
    .sd_clk_hi(sd_clk_hi),
	.sd_clk_lo(sd_clk_lo),
	.sd_cmd_i(sd_cmd_i),
	.sd_cmd_o(sd_cmd_o),
	.sd_cmd_oe(sd_cmd_oe),
	.sd_dat_i(sd_dat_i),
	.sd_dat_o(sd_dat_o),
	.sd_dat_oe(sd_dat_oe),
	.sd_wp(),
	.sd_cd_n(),
    
    
`ifndef SOFT_TAP
	.jtagCtrl_tck		(jtag_inst1_TCK),
	.jtagCtrl_tdi		(jtag_inst1_TDI),
	.jtagCtrl_tdo		(jtag_inst1_TDO),
	.jtagCtrl_enable	(jtag_inst1_SEL),
	.jtagCtrl_capture	(jtag_inst1_CAPTURE),
	.jtagCtrl_shift		(jtag_inst1_SHIFT),
	.jtagCtrl_update	(jtag_inst1_UPDATE),
	.jtagCtrl_reset		(jtag_inst1_RESET)
`else
	.io_jtag_tck		(io_jtag_tck),
	.io_jtag_tdi		(io_jtag_tdi),
	.io_jtag_tdo		(io_jtag_tdo),
	.io_jtag_tms		(io_jtag_tms)
`endif
);




