wire            			io_w_payload_last;
wire            			io_b_valid;
wire            			io_b_ready;
wire    [7:0]   			io_b_payload_id;
wire            			io_r_valid;
wire            			io_r_ready;
wire    [AXI_DBW-1:0]  		io_r_payload_data;
wire    [7:0]   			io_r_payload_id;
wire    [1:0]   			io_r_payload_resp;
wire            			io_r_payload_last;
wire	[1:0]				io_b_payload_resp;


wire    [5:0]               w_soc_led;
wire 	[5:0]				w_soc_switch;
wire    system_i2c_0_io_sda_write;
wire    system_i2c_0_io_sda_read;
wire    system_i2c_0_io_scl_write;
wire    system_i2c_0_io_scl_read;


assign system_i2c_0_io_sda_read = i_cam_sda[0];
assign o_cam_sda_oe[0] = ~system_i2c_0_io_sda_write; 
assign system_i2c_0_io_scl_read = i_cam_scl[0];
assign o_cam_scl_oe[0] = ~system_i2c_0_io_scl_write; 


wire w_mainReset;
wire w_mainResetn;
wire w_config_reset;
wire w_config_resetn;


assign w_arstn  = i_pll_locked & i_mipi_tx_pll_locked & i_hbramClk_pll_locked;
assign w_mainReset = (w_hbc_cal_pass==1'b0) | (w_arstn==1'b0) ;
//assign w_mainReset = (w_arstn==1'b0) ;
assign w_mainResetn = ~w_mainReset; 
assign w_config_reset = (i_pll_locked==1'b0) |  (w_hbc_cal_pass==1'b0) | (w_arstn==1'b0);
assign w_config_resetn = ~w_config_reset;


`define REST_COUNT         26
`define RESET_LCD          26'd6250000
`define RELEASE_RESET_LCD  26'd12500000
`define RELEASE_RESET_ALL  26'd25000000


reg 	r_rstn_video;
reg 	[10:0]	r_hs_cnt;
reg 	[8:0]	r_frame_cnt;

reg		[`REST_COUNT-1:0]	r_rst_cnt;
reg				r_lcd_rstn;
reg				r_lcd_en;

(* async_reg = "true" *) reg     r_release_resetn;

		always@(negedge i_arstn or posedge i_fb_clk)
		begin
			if (~i_arstn)
			begin
				r_rst_cnt			<= {`REST_COUNT{1'b0}};
				r_lcd_rstn			<= 1'b1;		
				r_lcd_en			<= 1'b0;
                r_release_resetn     <= 1'b0;
			end
			else
			begin		
            
                if(w_mainReset==1'b0)
                begin
                    if(r_rst_cnt != {`REST_COUNT{1'b1}})
                    begin
                        r_rst_cnt	<= r_rst_cnt + 1'b1;
                        if(r_rst_cnt == `RESET_LCD)
                        begin
                            r_lcd_rstn<= 1'b0;
                        end
                        else if (r_rst_cnt == `RELEASE_RESET_LCD)
                        begin
                             r_lcd_rstn<= 1'b1;
                        end
                        else if  (r_rst_cnt == `RELEASE_RESET_ALL)
                        begin
                            r_release_resetn <= 1'b1;
                        end                       
                    end
                end
                else 
                begin
                    r_rst_cnt		 <= {`REST_COUNT{1'b0}};
                    r_release_resetn <= 1'b0;
                    r_lcd_rstn		 <= 1'b1;
                end
            
           
			end
		end



reset_ctrl
#(
	.NUM_RST		(6),
	.CYCLE			(1),
	.IN_RST_ACTIVE	(6'b000000),
	.OUT_RST_ACTIVE	(6'b101010)
)
inst_reset_ctrl
(
	.i_arst				({6{r_release_resetn}}),//({{4{i_pll_locked}},                  {2{i_arstn}}}),
	.i_clk				({{2{i_mipi_rx_pclk}}, {2{i_fb_clk}}, {2{i_sysclk}}}),
	.o_srst				({	w_mipi_rx_pclk_arst, w_mipi_rx_pclk_arstn,
							w_fb_clk_arst,       w_fb_clk_arstn,
							w_sysclk_arst,       w_sysclk_arstn})
);


reset_ctrl
#(
	.NUM_RST		(2),
	.CYCLE			(10),
	.IN_RST_ACTIVE	(2'b00),
	.OUT_RST_ACTIVE	(2'b10)
)
inst_reset_mcu_ctrl
(
	.i_arst				({2{r_release_resetn}}),//({2{w_mainResetn}} ),
	.i_clk				({2{i_soc_clk}}),
	.o_srst				({w_sysclk_mcu_arst,w_sysclk_mcu_arstn})
);


assign	o_lcd_rstn	        = r_lcd_rstn;

assign w_vio_map_sel = 1'b1;

assign	w_r_gain	= (w_vio_map_sel)?	w_vio_r_gain:3'd7;
assign	w_g_gain	= (w_vio_map_sel)?	w_vio_g_gain:3'd4;
assign	w_b_gain	= (w_vio_map_sel)?	w_vio_b_gain:3'd6;

////////////////////////////////////////////////////////////////




genvar	j, k;
generate
	for (k=0; k<NUM_CAM; k=k+1)
	begin
		wire	w_cam_ck_HS_ENA;
		wire	w_cam_ck_HS_TERM;
		wire	[1:0]w_cam_d_HS_ENA;
		wire	[1:0]w_cam_d_HS_TERM;
		wire	[3:0]w_mipi_rx_vs_vc;
		wire	[3:0]w_mipi_rx_hs_vc;
		wire	[3:0]w_mipi_rx_de_vc;
//		assign	o_cam_ck_HS_TERM[k]	= w_cam_ck_HS_TERM;
//		assign	o_cam_d0_HS_TERM[k]	= w_cam_d_HS_TERM[0];
//		assign	o_cam_d1_HS_TERM[k]	= w_cam_d_HS_TERM[1];
		assign	o_cam_ck_HS_TERM[k]	= w_cam_ck_HS_ENA;
		assign	o_cam_d0_HS_TERM[k]	= w_cam_d_HS_ENA[0];
		assign	o_cam_d1_HS_TERM[k]	= w_cam_d_HS_ENA[1];
		assign	o_cam_ck_HS_ENA[k]	= w_cam_ck_HS_ENA;
		assign	o_cam_d0_HS_ENA[k]	= w_cam_d_HS_ENA[0];
		assign	o_cam_d1_HS_ENA[k]	= w_cam_d_HS_ENA[1];
		assign	o_cam_d0_RST[k]		= 1'b0;
		assign	o_cam_d1_RST[k]		= 1'b0;
		
		reset
		#(
			.IN_RST_ACTIVE	("LOW"),
			.OUT_RST_ACTIVE	("LOW"),
			.CYCLE			(3)
		)
		inst_cam_ck_rstn
		(
			.i_arst	(r_release_resetn),
			.i_clk	(i_cam_ck_CLKOUT[k]),
			.o_srst	(w_cam_ck_arstn[k])
		);
		
		reset
		#(
			.IN_RST_ACTIVE	("LOW"),
			.OUT_RST_ACTIVE	("HIGH"),
			.CYCLE			(3)
		)
		inst_cam_ck_rst
		(
			.i_arst	(r_release_resetn),
			.i_clk	(i_cam_ck_CLKOUT[k]),
			.o_srst	(w_cam_ck_arst[k])
		);
		
		


		assign o_cam_rstn[k]= ~w_fb_clk_arst;

		
		
		(* async_reg = "true" *)reg		[1:0]r_mipi_rx_data_LP_P_IN_1P;
		(* async_reg = "true" *)reg		[1:0]r_mipi_rx_data_LP_N_IN_1P;
		(* async_reg = "true" *)reg		[15:0]r_mipi_rx_data_HS_IN_1P;
		
		(* async_reg = "true" *)reg		[1:0]r_mipi_rx_data_LP_P_IN_2P;
		(* async_reg = "true" *)reg		[1:0]r_mipi_rx_data_LP_N_IN_2P;
		(* async_reg = "true" *)reg		[15:0]r_mipi_rx_data_HS_IN_2P;
		
		always@(negedge i_arstn or posedge i_cam_ck_CLKOUT[k])
		begin
			if (~i_arstn)
			begin
				r_mipi_rx_data_LP_P_IN_1P	<= {2{1'b0}};
				r_mipi_rx_data_LP_N_IN_1P	<= {2{1'b0}};
				r_mipi_rx_data_HS_IN_1P		<= {16{1'b0}};
				
				r_mipi_rx_data_LP_P_IN_2P	<= {2{1'b0}};
				r_mipi_rx_data_LP_N_IN_2P	<= {2{1'b0}};
				r_mipi_rx_data_HS_IN_2P		<= {16{1'b0}};
			end
			else
			begin
				r_mipi_rx_data_LP_P_IN_1P	<= {i_cam_d1_LP_P_IN[k],    i_cam_d0_LP_P_IN[k]}; 
				r_mipi_rx_data_LP_N_IN_1P	<= {i_cam_d1_LP_N_IN[k],    i_cam_d0_LP_N_IN[k]};
				r_mipi_rx_data_HS_IN_1P		<= {w_cam_d1_HS_IN[k*8+:8], w_cam_d0_HS_IN[k*8+:8]};
				
				r_mipi_rx_data_LP_P_IN_2P	<= r_mipi_rx_data_LP_P_IN_1P;
				r_mipi_rx_data_LP_N_IN_2P	<= r_mipi_rx_data_LP_N_IN_1P;
				r_mipi_rx_data_HS_IN_2P		<= r_mipi_rx_data_HS_IN_1P;
			end
		end
		

		csi_rx_controller inst_efx_csi2_rx
		(
			.reset_n			(i_arstn),
			.clk				(i_mipi_clk),
			.reset_byte_HS_n	(i_arstn),
			.clk_byte_HS		(i_cam_ck_CLKOUT[k]),
			.reset_pixel_n		(w_mipi_rx_pclk_arstn),
			.clk_pixel			(i_mipi_rx_pclk),
			
			.Rx_LP_CLK_P		(i_cam_ck_LP_P_IN[k]),
			.Rx_LP_CLK_N		(i_cam_ck_LP_N_IN[k]),
			.Rx_HS_enable_C		(w_cam_ck_HS_ENA),
			.LVDS_termen_C		(w_cam_ck_HS_TERM),
			
			.Rx_LP_D_P			(r_mipi_rx_data_LP_P_IN_2P),
			.Rx_LP_D_N			(r_mipi_rx_data_LP_N_IN_2P),
			.Rx_HS_D_0			(r_mipi_rx_data_HS_IN_2P[0*8+:8]),
			.Rx_HS_D_1			(r_mipi_rx_data_HS_IN_2P[1*8+:8]),
			.Rx_HS_D_2			(),
			.Rx_HS_D_3			(),
			.Rx_HS_D_4			(),
			.Rx_HS_D_5			(),
			.Rx_HS_D_6			(),
			.Rx_HS_D_7			(),
			.Rx_HS_enable_D		( w_cam_d_HS_ENA),
			.LVDS_termen_D		( w_cam_d_HS_TERM),
			.fifo_rd_enable		({o_cam_d1_FIFO_RD[k],    o_cam_d0_FIFO_RD[k]}),
			.fifo_rd_empty		({i_cam_d1_FIFO_EMPTY[k], i_cam_d0_FIFO_EMPTY[k]}),
			.DLY_enable_D		(),
			.DLY_inc_D			(),
			.u_dly_enable_D		(),
			.u_dly_inc_D		(),
			
			.axi_clk			(1'b0),
			.axi_reset_n		(1'b0),
			.axi_awaddr			(6'b0),
			.axi_awvalid		(1'b0),
			.axi_awready		(),
			.axi_wdata			(32'b0),
			.axi_wvalid			(1'b0),
			.axi_wready			(),
			
			.axi_bvalid			(),
			.axi_bready			(1'b0),
			.axi_araddr			(6'b0),
			.axi_arvalid		(1'b0),
			.axi_arready		(),
			.axi_rdata			(),
			.axi_rvalid			(),
			.axi_rready			(1'b0),
			
			.hsync_vc0			(w_mipi_rx_hs[k]),
			.hsync_vc1			(),
			.hsync_vc2			(),
			.hsync_vc3			(),
			.vsync_vc0			(w_mipi_rx_vs[k]),
			.vsync_vc1			(),
			.vsync_vc2			(),
			.vsync_vc3			(),
			.vc					(w_mipi_rx_vc[k]),
			.word_count			(),
			.shortpkt_data_field(),
			.datatype			(w_mipi_rx_dt[k]),
			.pixel_per_clk		(),
			.pixel_data			(w_mipi_rx_data[k][39:0]),
			.pixel_data_valid	(w_mipi_rx_de[k]),
			.irq				()
		);
		
		reg		[10:0]			r_rx_x_mipi	[0:NUM_CAM-1];
		reg		[10:0]			r_rx_y_mipi	[0:NUM_CAM-1];
		reg		[NUM_CAM-1:0]	r_rx_hs;
		reg		[NUM_CAM-1:0]	r_rx_valid;
		reg		[NUM_CAM-1:0]	r_rx_vs;		
		
		always@(negedge w_mipi_rx_pclk_arstn or posedge i_mipi_rx_pclk)
		begin
			if (~w_mipi_rx_pclk_arstn)
			begin
				r_rx_x_mipi[k]	<= {11{1'b0}};
				r_rx_y_mipi[k]	<= {11{1'b0}};
				r_rx_hs[k]		<= 1'b0;
				r_rx_valid[k]	<= 1'b0;
				r_rx_vs[k]		<= 1'b0;
			end
			else
			begin
				r_rx_vs[k]		<= w_mipi_rx_vs[k];
				r_rx_hs[k]		<= w_mipi_rx_hs[k];
				r_rx_valid[k]	<= w_mipi_rx_de[k];
				
				if (w_mipi_rx_hs[k])
				begin
					if (w_mipi_rx_de[k])
						r_rx_x_mipi[k]	<= r_rx_x_mipi[k] + 1'b1;
				end	
				else
					r_rx_x_mipi[k]	<= {11{1'b0}};
				
				if (w_mipi_rx_hs[k] && !r_rx_hs[k])
					r_rx_y_mipi[k]	<= r_rx_y_mipi[k] + 1'b1;
										
				if (!w_mipi_rx_vs[k] && r_rx_vs[k])
					r_rx_y_mipi[k]	<= {11{1'b0}};
			end
		end
	
	end
	
	for (j=0; j<NUM_PANEL; j=j+1)
	begin
		rgb_gain
		#(
			.P_DEPTH(8),
			.PW		(32)
		)
		inst_rgb_gain
		(
			.i_pclk		(i_sysclk),
			.i_arstn	(w_sysclk_arstn),
			.i_hs		(w_frame_buf_hs[j]),
			.i_vs		(w_frame_buf_vs[j]),
			.i_de		(w_frame_buf_ah[j]),
			.i_valid	(w_frame_buf_de[j]),
			.i_data		(w_frame_buf_data[j][31:0]),
			
			.blue_gain	(w_r_gain),
			.green_gain	(w_g_gain),
			.red_gain	(w_b_gain),
			
			.o_hs		(w_gain_hs[j]),
			.o_vs		(w_gain_vs[j]),
			.o_de		(w_gain_ah[j]),
			.o_valid	(w_gain_de[j]),
			.o_data		(w_gain_data[j])
		);

		always@(negedge w_sysclk_arstn or posedge i_sysclk)
		begin
			if (~w_sysclk_arstn)
			begin
				r_gain_vs_1P[j]		<= 1'b0;
				r_gain_hs_1P[j]		<= 1'b0;
				r_gain_ah_1P[j]		<= 1'b0;
				r_gain_de_1P[j]		<= 1'b0;
				r_gain_pixel_1P[j]	<= {32{1'b0}};
			end
			else
			begin
				r_gain_vs_1P[j]		<= w_gain_vs[j];
				r_gain_hs_1P[j]		<= w_gain_hs[j];
				r_gain_ah_1P[j]		<= w_gain_ah[j];
				if (w_gain_de[j])
				begin
					r_gain_pixel_1P[j][31:24]	<= w_gain_data[j][31:24];
					r_gain_pixel_1P[j][23:16]	<= w_gain_data[j][23:16];
					r_gain_pixel_1P[j][15: 8]	<= w_gain_data[j][15: 8];
					r_gain_pixel_1P[j][ 7: 0]	<= w_gain_data[j][ 7: 0];
					r_gain_de_1P[j]		<= 1'b1;
				end
				else
				begin
					r_gain_pixel_1P[j]	<= {{8{1'b0}}, r_gain_pixel_1P[j][31:8]};
					if (w_gain_ah[j])
						r_gain_de_1P[j]	<= ~r_gain_de_1P[j];
					else
						r_gain_de_1P[j]	<= 1'b0;
				end
			end
		end


     /*   reg r_test_hs_1P;
        reg r_test_hs_2P;

        reg r_test_vs_1P;
        reg r_test_vs_2P;

        
        reg [19:0] r_test_vs_count;
        reg [19:0] r_test_hs_count;

        
        always@(negedge w_sysclk_arstn or posedge i_sysclk)
		begin
			if (~w_sysclk_arstn)
			begin
				r_test_hs_1P		<= 1'b0;
				r_test_hs_2P		<= 1'b0;
				r_test_vs_1P		<= 1'b0;
				r_test_vs_2P     	<= 1'b0;
				r_test_hs_count   	<= {20{1'b0}};
                r_test_vs_count   	<= {20{1'b0}};
			end
			else
			begin
                r_test_hs_1P <= r_gain_hs_1P[j];
                r_test_hs_2P <= r_test_hs_1P;
                
                 r_test_vs_1P <= r_gain_vs_1P[j];
                r_test_vs_2P <= r_test_vs_1P;
                
                if(r_test_vs_1P & ~r_test_vs_2P)
                begin
                    r_test_vs_count   	<= {20{1'b0}};
                    r_test_hs_count	    <= {20{1'b0}};
                end
                
                if(r_test_hs_1P & ~r_test_hs_2P)
                begin
                    r_test_vs_count   	<= r_test_vs_count +1'b1;
                    r_test_hs_count	    <= {20{1'b0}};
                end
                else if(r_test_hs_1P)
                begin
                    r_test_hs_count   	<= r_test_hs_count +1'b1;
                  
                
                end
                
			end
		end*/
        
        
		line_buffer
		#(
			.P_DEPTH	(8),
			.X_CNT_WIDTH(10)
		)
		inst_line_buffer_debayer
		(
			.i_arstn	(w_sysclk_arstn),
			.i_pclk		(i_sysclk),
			
			.i_vsync	(r_gain_vs_1P[j]),
			.i_hsync	(r_gain_hs_1P[j]),
			.i_de		(r_gain_ah_1P[j]),
			.i_valid	(r_gain_de_1P[j]),
			.i_p		(r_gain_pixel_1P[j][15:0]),
			
			.o_vsync	(w_debayer_lb_vs[j]),
			.o_hsync	(w_debayer_lb_hs[j]),
			.o_de		(w_debayer_lb_ah[j]),
			.o_valid	(w_debayer_lb_de[j]),
			.o_p_11		(w_debayer_lb_p_11[j]),
			.o_p_00		(w_debayer_lb_p_00[j]),
			.o_p_01		(w_debayer_lb_p_01[j])
		);
		
       
        
		raw_to_rgb
		#(
			.P_DEPTH	(8),
			.LEGACY		(1'b1)
		)
		inst_raw_to_rgb
		(
			.i_arstn	(w_sysclk_arstn),
			.i_pclk		(i_sysclk),
			
			.i_r_addn	(1'b0),
			.i_r_gain	(8'b0),
			.i_r_shift	(1'b0),
			.i_g_addn	(1'b0),
			.i_g_gain	(8'b0),
			.i_g_shift	(1'b0),
			.i_b_addn	(1'b0),
			.i_b_gain	(8'b0),
			.i_b_shift	(1'b0),
			
			.i_vsync	(w_debayer_lb_vs[j]),
			.i_hsync	(w_debayer_lb_hs[j]),
			.i_de		(w_debayer_lb_ah[j]),
			.i_valid	(w_debayer_lb_de[j]),
			.i_p_11		(w_debayer_lb_p_11[j]),
			.i_p_00		(w_debayer_lb_p_00[j]),
			.i_p_01		(w_debayer_lb_p_01[j]),
			
			.o_dbg_valid			(),
			.o_dbg_bayer_11_01_0P_0	(),
			.o_dbg_bayer_11_01_0P_1	(),
			.o_dbg_bayer_00_01_0P_0	(),
			.o_dbg_bayer_00_01_0P_1	(),
			.o_dbg_bayer_01_01_0P_0	(),
			.o_dbg_bayer_01_01_0P_1	(),
			.o_dbg_bayer_11_00_1P_0	(),
			.o_dbg_bayer_11_00_1P_1	(),
			.o_dbg_bayer_00_00_1P_0	(),
			.o_dbg_bayer_00_00_1P_1	(),
			.o_dbg_bayer_01_00_1P_0	(),
			.o_dbg_bayer_01_00_1P_1	(),
			.o_dbg_bayer_11_11_2P_0	(),
			.o_dbg_bayer_11_11_2P_1	(),
			.o_dbg_bayer_00_11_2P_0	(),
			.o_dbg_bayer_00_11_2P_1	(),
			.o_dbg_bayer_01_11_2P_0	(),
			.o_dbg_bayer_01_11_2P_1	(),
			
			.o_vsync	(w_debayer_vs[j]),
			.o_hsync	(w_debayer_hs[j]),
			.o_de		(w_debayer_ah[j]),
			.o_valid	(w_debayer_de[j]),
			.o_x_cnt	(w_debayer_x[j]),
			.o_y_cnt	(w_debayer_y[j]),
			.o_r		(w_debayer_r[j]),
			.o_g		(w_debayer_g[j]),
			.o_b		(w_debayer_b[j])
		);
        
		always@(negedge w_sysclk_arstn or posedge i_sysclk_div_2)
		begin
			if (~w_sysclk_arstn)
			begin
				r_debayer_vs_1P[j]		<= 1'b0;
				r_debayer_hs_1P[j]		<= 1'b0;
				r_debayer_ah_1P[j]		<= 1'b0;
				r_debayer_de_1P[j]		<= 1'b0;
				r_debayer_x_1P[j]		<= {11{1'b0}};
				r_debayer_y_1P[j]		<= {11{1'b0}};
				r_debayer_r_1P[j]		<= {16{1'b0}};
				r_debayer_g_1P[j]		<= {16{1'b0}};
				r_debayer_b_1P[j]		<= {16{1'b0}};
				
				r_rstn_video			<= 1'b0;
				r_hs_cnt				<= {11{1'b0}};
				r_frame_cnt				<= {9{1'b0}};
			end
			else
			begin
				r_debayer_vs_1P[j]		<= w_debayer_vs[j];
				r_debayer_hs_1P[j]		<= w_debayer_hs[j];
				r_debayer_ah_1P[j]		<= w_debayer_ah[j];
				r_debayer_de_1P[j]		<= w_debayer_de[j];
				r_debayer_x_1P[j]		<= w_debayer_x[j];
				r_debayer_y_1P[j]		<= w_debayer_y[j];
				r_debayer_r_1P[j]		<= w_debayer_r[j];
				r_debayer_g_1P[j]		<= w_debayer_g[j];
				r_debayer_b_1P[j]		<= w_debayer_b[j];
									
				if ((r_debayer_y_1P[0] == MAX_VRES - 1) && (r_debayer_x_1P[0] == MAX_HRES/2 - 1))
					r_frame_cnt	<= r_frame_cnt + 1'b1;
							
				if 	(r_frame_cnt[0] && w_debayer_hs[0] && ~r_debayer_hs_1P[0])
					r_hs_cnt	<= r_hs_cnt + 1'b1;
				
				if (r_hs_cnt == VFP)
					r_rstn_video	<= 1'b1;
			end
		end
		
	//	assign	o_led	= r_frame_cnt[5];
		
		/* Panel driver initialization */
		panel_config
		#(
			.INITIAL_CODE	("rtl/panel/panel_config.mem"),
			.REG_DEPTH		(9'd15)
		)
		inst_panel_config
		(
			.i_axi_clk		(i_fb_clk			),
			.i_restn		(w_fb_clk_arstn		),
			
			.i_axi_awready	(w_axi_awready[j]	),
			.i_axi_wready	(w_axi_wready[j]	),
			.i_axi_bvalid	(w_axi_bvalid[j]	),
			.o_axi_awaddr	(w_axi_awaddr[j]	),
			.o_axi_awvalid	(w_axi_awvalid[j]	),
			.o_axi_wdata	(w_axi_wdata[j]		),
			.o_axi_wvalid	(w_axi_wvalid[j]	),
			.o_axi_bready	(w_axi_bready[j]	),
			
			.i_axi_arready	(w_axi_arready[j]	),
			.i_axi_rdata	(w_axi_rdata[j]		),
			.i_axi_rvalid	(w_axi_rvalid[j]	),
			.o_axi_araddr	(w_axi_araddr[j]	),
			.o_axi_arvalid	(w_axi_arvalid[j]	),
			.o_axi_rready	(w_axi_rready[j]	),
			
			.o_addr_cnt		(			),
			.o_state		(			),
			.o_confdone		(w_confdone	),
			
			.i_dbg_we		(0	),
			.i_dbg_din		(0	),
			.i_dbg_addr		(0	),
			.o_dbg_dout		(	),
			.i_dbg_reconfig	(0	)
		);
		
		/* MIPI TX Channel */
		efx_dsi_tx

		inst_efx_dsi_tx
		(
			.reset_n			(w_sysclk_arstn	),
			.clk				(i_mipi_clk),		// 100
			.reset_byte_HS_n	(w_sysclk_arstn	),
			.clk_byte_HS		(i_mipi_tx_pclk),	// 1000/8=125
			.reset_pixel_n		(r_rstn_video	),
			.clk_pixel			(i_sysclk_div_2	),  // 1000/16=62.5
			// LVDS clock lane   
			.Tx_LP_CLK_P		(mipi_tx_clk_LP_P_OUT[j]),
			.Tx_LP_CLK_N		(mipi_tx_clk_LP_N_OUT[j]),
			.Tx_HS_enable_C		(mipi_tx_clk_HS_OE[j]),
			.Tx_HS_C            (mipi_tx_clk0_HS_OUT),
			// ----- DLane -----------
			// LVDS data lane
			.Tx_LP_D_P			({mipi_tx_data3_LP_P_OUT[j], mipi_tx_data2_LP_P_OUT[j], mipi_tx_data1_LP_P_OUT[j], mipi_tx_data0_LP_P_OUT[j]}),
			.Tx_LP_D_P_OE       ({mipi_tx_data3_LP_P_OE[j], mipi_tx_data2_LP_P_OE[j], mipi_tx_data1_LP_P_OE[j], mipi_tx_data0_LP_P_OE[j]}),
			.Tx_LP_D_N			({mipi_tx_data3_LP_N_OUT[j], mipi_tx_data2_LP_N_OUT[j], mipi_tx_data1_LP_N_OUT[j], mipi_tx_data0_LP_N_OUT[j]}),
			.Tx_LP_D_N_OE       ({mipi_tx_data3_LP_N_OE[j], mipi_tx_data2_LP_N_OE[j], mipi_tx_data1_LP_N_OE[j], mipi_tx_data0_LP_N_OE[j]}),
			.Tx_HS_D_0			(mipi_tx_data0_HS_OUT_0),
			.Tx_HS_D_1			(mipi_tx_data1_HS_OUT_0),
			.Tx_HS_D_2			(mipi_tx_data2_HS_OUT_0),
			.Tx_HS_D_3			(mipi_tx_data3_HS_OUT_0),
		//	.Tx_HS_D_4			(),
		//	.Tx_HS_D_5			(),
		//	.Tx_HS_D_6			(),
		//	.Tx_HS_D_7			(),
			// control signal to LVDS IO
			.Tx_HS_enable_D		({mipi_tx_data3_HS_OE[j], mipi_tx_data2_HS_OE[j], mipi_tx_data1_HS_OE[j], mipi_tx_data0_HS_OE[j]}),
			.Rx_LP_D_P			(mipi_tx_data0_LP_P_IN[j]),
			.Rx_LP_D_N			(mipi_tx_data0_LP_N_IN[j]),
			
			//AXI4-Lite Interface
			.axi_clk		(i_fb_clk			), 
			.axi_reset_n	(w_fb_clk_arstn		),
			.axi_awaddr		(w_axi_awaddr[j]	),//Write Address. byte address.
			.axi_awvalid	(w_axi_awvalid[j]	),//Write address valid.
			.axi_awready	(w_axi_awready[j]	),//Write address ready.
			.axi_wdata		(w_axi_wdata[j]		),//Write data bus.
			.axi_wvalid		(w_axi_wvalid[j]	),//Write valid.
			.axi_wready		(w_axi_wready[j]	),//Write ready.
								  
			.axi_bvalid		(w_axi_bvalid[j]	),//Write response valid.
			.axi_bready		(w_axi_bready[j]	),//Response ready.      
			.axi_araddr		(w_axi_araddr[j]	),//Read address. byte address.
			.axi_arvalid	(w_axi_arvalid[j]	),//Read address valid.
			.axi_arready	(w_axi_arready[j]	),//Read address ready.
			.axi_rdata		(w_axi_rdata[j]		),//Read data.
			.axi_rvalid		(w_axi_rvalid[j]	),//Read valid.
			.axi_rready		(w_axi_rready[j]	),//Read ready.
			
			.hsync				(~r_debayer_hs_1P[j]),	//(~w_pack_hs[j]			),
			.vsync				(~r_debayer_vs_1P[j]),	//(~w_pack_vs[j]			),
			.vc					(2'b0					),
			.datatype			(6'h3E					),   // data type of the Long Packet
			.pixel_data			({16'b0, r_debayer_r_1P[j][15:8], r_debayer_g_1P[j][15:8], r_debayer_b_1P[j][15:8], r_debayer_r_1P[j][7:0], r_debayer_g_1P[j][7:0], r_debayer_b_1P[j][7:0]}),	//({16'b0, w_pack_data[j]}),
			.pixel_data_valid	(r_debayer_ah_1P[j]),	//(w_pack_valid[j]		),
			.haddr				(1080					),
			.TurnRequest_dbg    (1'b0					),
			.TurnRequest_done	(),
			.irq				()
		);		
	end
endgenerate

////////////////////////////////////////////////////////////////
always@(negedge w_sysclk_arstn or posedge i_sysclk)
begin
	if (~w_sysclk_arstn)
	begin
		r_hbc_cal_pass_1P	<= 1'b0;
		r_hbc_cal_pass_2P	<= 1'b0;
	end
	else
	begin
		r_hbc_cal_pass_1P	<= w_hbc_cal_pass;
		r_hbc_cal_pass_2P	<= r_hbc_cal_pass_1P;
	end
end





