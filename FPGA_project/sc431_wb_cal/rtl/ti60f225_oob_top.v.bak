	.io_ddrA_w_payload_last		(io_w_payload_last),
	.io_ddrA_b_valid			(io_b_valid),
	.io_ddrA_b_ready			(io_b_ready),
	.io_ddrA_b_payload_id		(io_b_payload_id),
	.io_ddrA_b_payload_resp		(io_b_payload_resp),
	.io_ddrA_r_valid			(io_r_valid),
	.io_ddrA_r_ready			(io_r_ready),
