`include "hyperram_controller_define.vh"
module ti60f225_oob_top
(
   //Clocks 
	input	wire	i_arstn,
    input	wire	i_fb_clk,
    input	wire	i_sysclk,
    input	wire	i_sysclk_div_2,
    input	wire	i_mipi_rx_pclk,
    input	wire	i_pll_locked,
   // output  wire    o_pll_RSTN,
    
    input	wire	i_mipi_clk,
    input	wire	i_mipi_txc_sclk,
    input	wire	i_mipi_txd_sclk,
    input	wire	i_mipi_tx_pclk,
    input	wire	i_mipi_tx_pll_locked,
   // output  wire     o_mipi_tx_pll_RSTN,
    
    input	wire	i_hbramClk,
    input	wire	i_hbramClk_cal,
    input	wire	i_hbramClk90,
    input	wire	i_hbramClk_pll_locked,
    
    input   wire    i_soc_clk,
    

    
    output	wire	o_lcd_rstn,
    //CSI Interface
    input	wire	[NUM_CAM-1:0]	i_cam_sda,
    output	wire	[NUM_CAM-1:0]	o_cam_sda_oe,
    input	wire	[NUM_CAM-1:0]	i_cam_scl,
    output	wire	[NUM_CAM-1:0]	o_cam_scl_oe,
    output	wire	[NUM_CAM-1:0]	o_cam_rstn,
    
    input	wire	[NUM_CAM-1:0]	i_cam_ck_LP_P_IN,
    input	wire	[NUM_CAM-1:0]	i_cam_ck_LP_N_IN,
    output	wire	[NUM_CAM-1:0]	o_cam_ck_HS_TERM,
    output	wire	[NUM_CAM-1:0]	o_cam_ck_HS_ENA,
    input	wire	[NUM_CAM-1:0]	i_cam_ck_CLKOUT,
    
    input	wire	[7:0]			i_cam_d0_HS_IN_0,
    input	wire	[7:0]			i_cam_d0_HS_IN_1,
    input	wire	[7:0]			i_cam_d0_HS_IN_2,
    input	wire	[7:0]			i_cam_d0_HS_IN_3,
    input	wire	[NUM_CAM-1:0]	i_cam_d0_LP_P_IN,
    input	wire	[NUM_CAM-1:0]	i_cam_d0_LP_N_IN,
    output	wire	[NUM_CAM-1:0]	o_cam_d0_HS_TERM,
    output	wire	[NUM_CAM-1:0]	o_cam_d0_HS_ENA,
    output	wire	[NUM_CAM-1:0]	o_cam_d0_RST,
    output	wire	[NUM_CAM-1:0]	o_cam_d0_FIFO_RD,
    input	wire	[NUM_CAM-1:0]	i_cam_d0_FIFO_EMPTY,
    
    input	wire	[7:0]			i_cam_d1_HS_IN_0,
    input	wire	[7:0]			i_cam_d1_HS_IN_1,
    input	wire	[7:0]			i_cam_d1_HS_IN_2,
    input	wire	[7:0]			i_cam_d1_HS_IN_3,
    input	wire	[NUM_CAM-1:0]	i_cam_d1_LP_P_IN,
    input	wire	[NUM_CAM-1:0]	i_cam_d1_LP_N_IN,
    output	wire	[NUM_CAM-1:0]	o_cam_d1_HS_TERM,
    output	wire	[NUM_CAM-1:0]	o_cam_d1_HS_ENA,
    output	wire	[NUM_CAM-1:0]	o_cam_d1_RST,
    output	wire	[NUM_CAM-1:0]	o_cam_d1_FIFO_RD,
    input	wire	[NUM_CAM-1:0]	i_cam_d1_FIFO_EMPTY,
    
    
    //DSI Interface
    output	wire	[NUM_PANEL-1:0]	mipi_tx_clk_LP_P_OUT,
    output	wire	[NUM_PANEL-1:0]	mipi_tx_clk_LP_N_OUT,
    output	wire	[NUM_PANEL-1:0]	mipi_tx_clk_HS_OE,
    output  wire    [7:0]           mipi_tx_clk0_HS_OUT,
    output	wire	[NUM_PANEL-1:0]	mipi_tx_data3_LP_P_OUT,
    output	wire	[NUM_PANEL-1:0]	mipi_tx_data2_LP_P_OUT,
    output	wire	[NUM_PANEL-1:0]	mipi_tx_data1_LP_P_OUT,
    output	wire	[NUM_PANEL-1:0]	mipi_tx_data0_LP_P_OUT,
    output	wire	[NUM_PANEL-1:0]	mipi_tx_data3_LP_N_OUT,
    output	wire	[NUM_PANEL-1:0]	mipi_tx_data2_LP_N_OUT,
    output	wire	[NUM_PANEL-1:0]	mipi_tx_data1_LP_N_OUT,
    output	wire	[NUM_PANEL-1:0]	mipi_tx_data0_LP_N_OUT,
    output	wire	[7:0] 	mipi_tx_data0_HS_OUT_0,
    output	wire	[7:0] 	mipi_tx_data1_HS_OUT_0,
    output	wire	[7:0] 	mipi_tx_data2_HS_OUT_0,
    output	wire	[7:0] 	mipi_tx_data3_HS_OUT_0,
    output	wire	[NUM_PANEL-1:0]	mipi_tx_data3_HS_OE,
    output	wire	[NUM_PANEL-1:0]	mipi_tx_data2_HS_OE,
    output	wire	[NUM_PANEL-1:0]	mipi_tx_data1_HS_OE,
    output	wire	[NUM_PANEL-1:0]	mipi_tx_data0_HS_OE,
    
    output	wire	[NUM_PANEL-1:0]	mipi_tx_clk_RST,
    output	wire	[NUM_PANEL-1:0]	mipi_tx_data0_RST,
    output	wire	[NUM_PANEL-1:0]	mipi_tx_data1_RST,
    output	wire	[NUM_PANEL-1:0]	mipi_tx_data2_RST,
    output	wire	[NUM_PANEL-1:0]	mipi_tx_data3_RST,
    output	wire	[NUM_PANEL-1:0]	mipi_tx_clk_LP_P_OE,
    output	wire	[NUM_PANEL-1:0]	mipi_tx_clk_LP_N_OE,
    output	wire	[NUM_PANEL-1:0]	mipi_tx_data3_LP_P_OE,
    output	wire	[NUM_PANEL-1:0]	mipi_tx_data3_LP_N_OE,
    output	wire	[NUM_PANEL-1:0]	mipi_tx_data2_LP_P_OE,
    output	wire	[NUM_PANEL-1:0]	mipi_tx_data2_LP_N_OE,
    output	wire	[NUM_PANEL-1:0]	mipi_tx_data1_LP_P_OE,
    output	wire	[NUM_PANEL-1:0]	mipi_tx_data1_LP_N_OE,
    output	wire	[NUM_PANEL-1:0]	mipi_tx_data0_LP_P_OE,
    output	wire	[NUM_PANEL-1:0]	mipi_tx_data0_LP_N_OE,
    
    input  	wire	[NUM_PANEL-1:0]	mipi_tx_data0_LP_P_IN,
    input  	wire	[NUM_PANEL-1:0]	mipi_tx_data0_LP_N_IN,
    
    
    //HyperRam IO Interface
    output	wire	[2:0]   o_hbc_cal_SHIFT,
    output	wire	[4:0]   o_hbc_cal_SHIFT_SEL,
    output	wire	        o_hbc_cal_SHIFT_ENA,
    output	wire	        o_hbramClk_pll_rstn,
    
    output	wire					hbc_rst_n,
    output	wire					hbc_cs_n,
    output	wire					hbc_ck_p_HI,
    output	wire					hbc_ck_p_LO,
    output	wire					hbc_ck_n_HI,
    output	wire					hbc_ck_n_LO,
    output	wire	[RAM_DBW/8-1:0] hbc_rwds_OUT_HI,
    output	wire	[RAM_DBW/8-1:0] hbc_rwds_OUT_LO,
    input	wire	[RAM_DBW/8-1:0] hbc_rwds_IN_HI,
    input	wire	[RAM_DBW/8-1:0] hbc_rwds_IN_LO,

    output	wire	[RAM_DBW/8-1:0] hbc_rwds_OE,
    output	wire	[RAM_DBW-1:0]	hbc_dq_OUT_HI,
    output	wire	[RAM_DBW-1:0]	hbc_dq_OUT_LO,
    input	wire	[RAM_DBW-1:0]	hbc_dq_IN_HI,
    input	wire	[RAM_DBW-1:0]	hbc_dq_IN_LO,
    output	wire	[RAM_DBW-1:0]	hbc_dq_OE,
    
  
    //USB3.0 Fx3 UVC Interface
    output [2:0] uvc_control,
    input uvc_in_reset,
    input [2:0] uvc_status,
    output uvc_vsync,
    output uvc_hsync,
    output [15:0] uvc_vdata,
    
    
    input uvc_out_resetn_IN,
    output uvc_out_resetn_OUT,
    output uvc_out_resetn_OE,
    
    //SD Interface
    output  wire                    sd_clk_hi,
   // output  wire                    sd_clk_lo,
    input                           sd_cmd_i,
    output  wire                    sd_cmd_o,
    output  wire                    sd_cmd_oe,
    input           [3:0]           sd_dat_i,
    output  wire    [3:0]           sd_dat_o,
    output  wire    [3:0]           sd_dat_oe,
    //input                         sd_wp,
    //input                         sd_cd_n
    
    //SOC IO
    output	wire    o_led0_r,
    output	wire    o_led0_g,
    output	wire    o_led0_b,
    
    output	wire    o_led1_r,
    output	wire    o_led1_g,
    output	wire    o_led1_b,
    
    input   i_sw0,
    input   i_sw1,
    input   i_sw2,
       
    output 					system_spi_0_io_sclk_write,
    output 					system_spi_0_io_data_0_writeEnable,
    input 					system_spi_0_io_data_0_read,
    output 					system_spi_0_io_data_0_write,
    output 					system_spi_0_io_data_1_writeEnable,
    input 					system_spi_0_io_data_1_read,
    output 					system_spi_0_io_data_1_write,  
    output 					system_spi_0_io_ss,
    
    output              	system_uart_0_io_txd,
    input               	system_uart_0_io_rxd,
    
    `ifndef SOFT_TAP
    input               		jtag_inst1_TCK,
    input               		jtag_inst1_TDI,
    output              		jtag_inst1_TDO,
    input               		jtag_inst1_SEL,
    input               		jtag_inst1_CAPTURE,
    input               		jtag_inst1_SHIFT,
    input               		jtag_inst1_UPDATE,
    input               		jtag_inst1_RESET
    `else
    input               		io_jtag_tms,
    input               		io_jtag_tdi,
    output              		io_jtag_tdo,
    input               		io_jtag_tck
    
    `endif
    
    
);

function integer log2;
	input	integer	val;
	integer	i;
	begin
		log2 = 0;
		for (i=0; 2**i<val; i=i+1)
			log2 = i+1;
	end
endfunction

parameter	MAX_HRES		= 12'd1080;
parameter	MAX_VRES		= 12'd1920;
parameter	HSP				= 8'd100;
parameter	HBP				= 8'd100;
parameter	HFP				= 8'd250;
parameter	VSP				= 6'd3;
parameter	VBP				= 6'd5;
parameter	VFP				= 6'd6;

parameter	NUM_CAM			= 1;
parameter	NUM_PANEL		= 1;
parameter	NUM_LANE		= 2;
parameter	DATA_RATE		= 900;

parameter	NUM_OF_POINT	= 4;

localparam	HRES_WIDTH		= log2(MAX_HRES);
localparam	VRES_WIDTH		= log2(MAX_VRES);




assign	mipi_tx_clk_RST[0]		= ~w_arstn;
assign	mipi_tx_data0_RST[0]	= ~w_arstn;
assign	mipi_tx_data1_RST[0]	= ~w_arstn;
assign	mipi_tx_data2_RST[0]	= ~w_arstn;
assign	mipi_tx_data3_RST[0]	= ~w_arstn;
assign	mipi_tx_clk_LP_P_OE[0]	= ~mipi_tx_clk_HS_OE[0];
assign	mipi_tx_clk_LP_N_OE[0]	= ~mipi_tx_clk_HS_OE[0];



assign	o_pll_RSTN	        = 1'b1;
assign	o_mipi_tx_pll_RSTN	= 1'b1;
assign	o_hbramClk_pll_rstn	= 1'b1;



assign o_led0_r = w_soc_led[0];
assign o_led0_g = w_soc_led[1];
assign o_led0_b = w_soc_led[2];

assign o_led1_r = w_soc_led[3];
assign o_led1_g = w_soc_led[4];
assign o_led1_b = w_soc_led[5];


assign w_soc_switch = {2'b00,i_sw2, i_sw1,i_sw0};

assign uvc_out_resetn_OUT = 1'b0;


